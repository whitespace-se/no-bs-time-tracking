---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/app.css';

// Already signed in? Nothing to do here.
if (Astro.locals.user) return Astro.redirect('/', 302);

const next = Astro.url.searchParams.get('next') ?? '';
const failed = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · No BS Time Tracking</title>
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <main class="login">
      <div class="login__card">
        <h1 class="login__title">No BS Time Tracking</h1>
        <p class="login__sub">Sign in to your timesheet.</p>

        {failed && (
          <p class="login__error" role="alert">
            That email and password didn’t match. Try again.
          </p>
        )}

        <form method="POST" action="/api/login" class="stack">
          <input type="hidden" name="next" value={next} />

          <div class="login__field">
            <label for="email">Email</label>
            <input
              class="field"
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              autofocus
            />
          </div>

          <div class="login__field">
            <label for="password">Password</label>
            <input
              class="field"
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </div>

          <button class="btn full login__submit" type="submit">Sign in</button>
        </form>
      </div>
    </main>
  </body>
</html>

<style>
  .login {
    /* Slightly above centre: a card pinned to the exact middle of a tall window reads as
       having drifted down. */
    min-height: 100vh;
    display: grid;
    place-items: center;
    align-content: center;
    padding: var(--app-4) var(--app-4) 12vh;
  }

  /* No border and no shadow. The card is a lighter plane than the page, and that difference
     alone is enough to read as a card — an outline round it would only draw attention to the
     box rather than to what is inside it. */
  .login__card {
    width: 100%;
    max-width: 23rem;
    background: var(--app-surface);
    padding: var(--app-6) var(--app-5) var(--app-5);
    border-radius: 1.25rem;
  }

  .login__title {
    font-size: 1.5rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    letter-spacing: -0.024em;
    line-height: 1.2;
    text-align: center;
  }
  .login__sub {
    margin-top: var(--app-2);
    margin-bottom: var(--app-6);
    font-size: var(--app-text);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* The label sits on the field rather than floating above a gap, so each pair reads as one
     control instead of two stacked things. */
  .login__field { display: grid; gap: 0.375rem; }
  .login__field label {
    font-size: var(--app-text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-soft);
  }
  .login__field :global(.field) {
    min-height: 2.75rem;
    padding-inline: var(--app-3);
    border-radius: 0.625rem;
    background: var(--app-fill);
    border-color: transparent;
  }
  .login__field :global(.field:hover:not(:focus)) {
    background: var(--app-fill-hover);
    border-color: transparent;
  }
  .login__field :global(.field:focus) {
    background: var(--app-surface);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .login__submit { min-height: 2.75rem; border-radius: 0.625rem; margin-top: var(--app-2); }

  .login__error {
    font-size: var(--app-text-sm);
    padding: var(--app-2) var(--app-3);
    margin-bottom: var(--app-4);
    border-radius: 0.625rem;
    color: var(--color-brown);
    background: color-mix(in srgb, var(--color-brown) 8%, transparent);
  }
</style>
