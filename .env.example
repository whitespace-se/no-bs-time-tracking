# Settings. All optional. Never commit real values; .env is gitignored.
#
# The app reads real environment variables and <INSTANCE_DIR>/.env, where real variables win.
# The import scripts (npm run import:*) read ./.env.

# ─── Instance ─────────────────────────────────────────────────────────────────
# Folder holding the database (timetrack.db), its per-instance .env and log/app.jsonl.
# A folder with exactly one .db file uses that file, so restoring a backup is dropping it in.
INSTANCE_DIR=./instances/default

# Key that encrypts the stored Harvest token. Unset, a key is generated and kept in the
# database. Set it (openssl rand -base64 32) to keep the key out of the database file.
SECRET_KEY=

# Set to off to stop writing <INSTANCE_DIR>/log/app.jsonl.
# INSTANCE_LOG=off

# ─── Network ──────────────────────────────────────────────────────────────────
# PORT=4321
# HOST=0.0.0.0

# Public address. Required behind a reverse proxy, or every form post is refused as cross-site
# and the session cookie is not marked Secure.
APP_URL=

# ─── Harvest import ───────────────────────────────────────────────────────────
# Only for the terminal import (npm run import:api). The setup wizard asks for these itself.
# Get them at https://id.getharvest.com/developers. The token has full account access.
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=
# Sent in the User-Agent, which Harvest requires.
HARVEST_CONTACT=you@example.com
# Another server that answers as Harvest's API does. Unset: https://api.harvestapp.com/v2
# HARVEST_API_URL=http://localhost:4322/v2
